# Credenciais do BBCE Connect (Portal do Desenvolvedor BBCE, plano Essentials).
# Copie este arquivo para ".env" na mesma pasta e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" preenchido -- ele contém segredos.

BBCE_API_KEY=
BBCE_EMAIL=
BBCE_PASSWORD=
# Código externo da empresa (companyExternalCode), numérico -- ex.: 1000
BBCE_COMPANY_EXTERNAL_CODE=

# Opcional. Só defina se a BBCE informar uma URL de produção diferente da
# usada nos exemplos do Portal do Desenvolvedor. Ver nota no README.md.
# BBCE_BASE_URL=https://api-beta.qa.bbce.tech/bus
